#!/usr/bin/env bash
# Reject staged content that carries work-product-boundary tells.
DIR="$(cd "$(dirname "$0")" && pwd)"
. "$DIR/dsmr-workproduct-lint.sh"
run_lint staged || exit $?

# Code linting is a different decision from the work-product gate above, and
# the two are deliberately not wired together. The gate above keeps our marks,
# our AI tells and our coordination vocabulary out of a repository, including
# repositories we did not start, so it runs everywhere. This step imposes our
# source style instead, which on a codebase we adopted rather than started is a
# judgment for the person who owns the relationship with that codebase.
#
# So it is off unless a repository opts in:
#   git config --bool dsmr.codelint.enabled true
#
# Two ways the linter can be unavailable, and they deserve different answers.
# A repository that never opted in is silent: a message on every commit in every
# such repository teaches the reader to ignore the one that matters. A
# repository that DID opt in and then finds no linter behind the wrapper (exit
# 127) is expecting its source to be checked, so it is told, on stderr, and the
# commit still goes through. A missing workspace checkout must not make a tree
# uncommittable.
REPO="$(git rev-parse --show-toplevel)"
if [ "$(git config --bool --get dsmr.codelint.enabled 2>/dev/null)" = "true" ] \
   && [ -x "$REPO/scripts/lint-lisp.sh" ]; then
  "$REPO/scripts/lint-lisp.sh" --staged
  lint_status=$?
  if [ "$lint_status" -eq 127 ]; then
    echo "pre-commit: the Lisp linter is not installed; code lint skipped." >&2
  elif [ "$lint_status" -ne 0 ]; then
    exit "$lint_status"
  fi
fi
exit 0
